{
  "info": {
    "name": "POC Bank System",
    "description": "Rode `npm run seed` antes para começar com Alice (R$ 1.000) e Bob (R$ 500). A conta logada é a do header `x-account-id`. Valores em centavos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "aliceId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "bobId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "unknownId", "value": "33333333-3333-4333-8333-333333333333" },
    { "key": "transferId", "value": "" },
    { "key": "aliceBalance", "value": "" },
    { "key": "bobBalance", "value": "" }
  ],
  "item": [
    {
      "name": "1. Fluxo principal",
      "item": [
        {
          "name": "Saldo da Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const { accountId, balance } = pm.response.json();",
                  "pm.test('retorna o saldo da Alice', () => {",
                  "  pm.expect(accountId).to.eql(pm.collectionVariables.get('aliceId'));",
                  "  pm.expect(balance).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('aliceBalance', balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{aliceId}}" }],
            "url": {
              "raw": "{{baseUrl}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["balance"]
            }
          }
        },
        {
          "name": "Saldo do Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('bobBalance', pm.response.json().balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{bobId}}" }],
            "url": {
              "raw": "{{baseUrl}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["balance"]
            }
          }
        },
        {
          "name": "Transferir R$ 150 da Alice para o Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const transfer = pm.response.json();",
                  "pm.test('retorna a transferência criada', () => {",
                  "  pm.expect(transfer.id).to.be.a('string');",
                  "  pm.expect(transfer.fromAccountId).to.eql(pm.collectionVariables.get('aliceId'));",
                  "  pm.expect(transfer.toAccountId).to.eql(pm.collectionVariables.get('bobId'));",
                  "  pm.expect(transfer.amount).to.eql(15000);",
                  "});",
                  "pm.collectionVariables.set('transferId', transfer.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-account-id", "value": "{{aliceId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAccountId\": \"{{bobId}}\",\n  \"amount\": 15000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["transfer"]
            }
          }
        },
        {
          "name": "Consultar transferência (Alice, remetente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('é a transferência criada', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transferId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{aliceId}}" }],
            "url": {
              "raw": "{{baseUrl}}/transfer/{{transferId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transfer", "{{transferId}}"]
            }
          }
        },
        {
          "name": "Consultar transferência (Bob, destinatário)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{bobId}}" }],
            "url": {
              "raw": "{{baseUrl}}/transfer/{{transferId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transfer", "{{transferId}}"]
            }
          }
        },
        {
          "name": "Saldo da Alice depois",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('diminuiu R$ 150', () => {",
                  "  const before = Number(pm.collectionVariables.get('aliceBalance'));",
                  "  pm.expect(pm.response.json().balance).to.eql(before - 15000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{aliceId}}" }],
            "url": {
              "raw": "{{baseUrl}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["balance"]
            }
          }
        },
        {
          "name": "Saldo do Bob depois",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('aumentou R$ 150', () => {",
                  "  const before = Number(pm.collectionVariables.get('bobBalance'));",
                  "  pm.expect(pm.response.json().balance).to.eql(before + 15000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{bobId}}" }],
            "url": {
              "raw": "{{baseUrl}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["balance"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Erros",
      "item": [
        {
          "name": "Saldo insuficiente (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('mensagem de saldo insuficiente', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Insufficient funds');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-account-id", "value": "{{bobId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAccountId\": \"{{aliceId}}\",\n  \"amount\": 99999999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["transfer"]
            }
          }
        },
        {
          "name": "Transferir para a própria conta (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-account-id", "value": "{{aliceId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAccountId\": \"{{aliceId}}\",\n  \"amount\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["transfer"]
            }
          }
        },
        {
          "name": "Destinatário inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-account-id", "value": "{{aliceId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAccountId\": \"{{unknownId}}\",\n  \"amount\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["transfer"]
            }
          }
        },
        {
          "name": "Body inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('lista os campos inválidos', () => {",
                  "  pm.expect(pm.response.json().message).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-account-id", "value": "{{aliceId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAccountId\": \"nao-e-uuid\",\n  \"amount\": 10.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["transfer"]
            }
          }
        },
        {
          "name": "Sem header x-account-id (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["balance"]
            }
          }
        },
        {
          "name": "Transferência de outra pessoa (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{unknownId}}" }],
            "url": {
              "raw": "{{baseUrl}}/transfer/{{transferId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transfer", "{{transferId}}"]
            }
          }
        },
        {
          "name": "ID de transferência inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-account-id", "value": "{{aliceId}}" }],
            "url": {
              "raw": "{{baseUrl}}/transfer/abc",
              "host": ["{{baseUrl}}"],
              "path": ["transfer", "abc"]
            }
          }
        }
      ]
    }
  ]
}
