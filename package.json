{
  "name": "poc-bank-system",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "seed": "nest start --entryFile seed.command",
    "migration:generate": "npm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "migration:run": "npm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "test:integration": "vitest run --project integration",
    "test:load": "docker compose -f load/docker-compose.yml up --build --attach k6 --exit-code-from k6; code=$?; docker compose -f load/docker-compose.yml down -v; exit $code",
    "test:load:warm": "WARMUP_SECONDS=${WARMUP_SECONDS:-15} npm run test:load",
    "seed:load": "nest start --entryFile seed.command -- --load-accounts=10000",
    "start:worker": "nest start --entryFile main.worker",
    "start:worker:dev": "nest start --watch --entryFile main.worker",
    "start:worker:prod": "node dist/main.worker"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "bullmq": "^6.3.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
